# Usuario objetivo a raspar
TARGET_USER=nombre_de_usuario

# Credenciales de sesión de Instagram (Cookies)
IG_SESSION_ID=tu_session_id_aqui
IG_DS_USER_ID=tu_ds_user_id_aqui

# =========================================================
# Control modular de extracción (true/false)
# =========================================================
# Desactiva seguidores y seguidos para acelerar drásticamente el scraping
SCRAPE_FOLLOWERS=false
SCRAPE_FOLLOWING=false
SCRAPE_POSTS=true
SCRAPE_COMMENTS=true

# =========================================================
# Límites de extracción (0 = sin límite)
# =========================================================
MAX_POSTS=5
MAX_COMMENTS_PER_POST=10
MAX_FOLLOWERS=0
MAX_FOLLOWING=0

# Navegador en segundo plano sin interfaz gráfica (true/false)
HEADLESS=false
